{
  "name": "leafy-ai-dashboard-apple-tradeshow",
  "version": "0.2.0-tradeshow.0",
  "description": "A guided, no-write Leafy AI tradeshow replay with an operator-only demo backstage.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build",
    "test:unit": "tsx --test tests/safety-policy.test.ts tests/dashboard-render.test.tsx tests/tradeshow-tour.test.tsx tests/tradeshow-backstage.test.tsx tests/api-auth.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render:ambient": "remotion render remotion/index.ts CommandAmbient public/remotion-command-ambient.mp4 --codec=h264 --crf=28 --muted --concurrency=50%",
    "remotion:render:replay": "remotion render remotion/index.ts CanopyReplay public/remotion-canopy-replay.mp4 --codec=h264 --crf=28 --muted --concurrency=50%",
    "remotion:still:ambient": "remotion still remotion/index.ts CommandAmbient public/remotion-command-poster.webp --frame=0 --image-format=webp",
    "remotion:still:replay": "remotion still remotion/index.ts CanopyReplay public/remotion-canopy-poster.webp --frame=0 --image-format=webp"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.0",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@remotion/cli": "4.0.499",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "remotion": "4.0.499",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.3.5",
    "wrangler": "^4.111.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
